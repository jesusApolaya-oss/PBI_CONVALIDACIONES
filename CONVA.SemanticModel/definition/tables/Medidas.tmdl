	measure Pendiente =
			
			CALCULATE (
			    COUNTROWS ( BBDD ),
			    REMOVEFILTERS ( BBDD[Estado] ),
			    KEEPFILTERS ( BBDD[Estado] = "Pendiente" )
			)
		formatString: 0
		lineageTag: 6ad14497-5bb3-4959-8edf-a4a9e422e0cb

	measure '% SLA Dentro' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(BBDD),
			        BBDD[SLA_OFI] = "Dentro"
			    ),
			    CALCULATE(
			        COUNTROWS(BBDD)
			    )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: ed1f0ad5-b1b3-4358-be9c-3a9d2c261904

	measure '% SLA Fuera' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(BBDD),
			        BBDD[SLA_OFI] = "Fuera"
			    ),
			    CALCULATE(
			        COUNTROWS(BBDD)
			    )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 3774e330-df7e-4bb9-9fd0-ccc93f1bec3f

	measure 'Dentro (conteo)' = ```
			
			VAR _conteo =
			    CALCULATE(
			        COUNTROWS(BBDD),
			        BBDD[SLA_OFI] = "Dentro"
			    )
			RETURN
			IF(
			    ISBLANK(_conteo),
			    0,
			    _conteo
			)
			
			```
		formatString: 0
		lineageTag: fc67f9c2-4910-4d31-962c-4e1a2aa1ea29

	measure 'Fuera (conteo)' =
			
			VAR _conteo =
			    CALCULATE(
			        COUNTROWS(BBDD),
			        BBDD[SLA_OFI] = "Fuera"
			    )
			RETURN
			IF(
			    ISBLANK(_conteo),
			    0,
			    _conteo
			)
		formatString: 0
		lineageTag: 0c42e608-11d1-460e-97bf-9320ac1553ea

	measure 'Total Dentro/Fuera SLA(conteo)' =
			
			COUNTROWS(BBDD)
		formatString: 0
		lineageTag: b4b73f9f-02fc-4c82-af04-a169d5fe7ea1

	measure 'Total (conteo)' = ```
			
			VAR _conteo =
			    CALCULATE(
			        COUNTROWS(BBDD),
			        BBDD[SLA_OFI] IN {"Dentro", "Fuera"}
			    )
			RETURN
			IF(ISBLANK(_conteo), 0, _conteo)
			
			```
		formatString: 0
		lineageTag: aa0b4f9c-102d-436f-aa2c-2637d4f2a76b

	measure 'Total por Responsable' = ```
			
			COUNT ( BBDD[Codigo] )
			
			```
		formatString: 0
		displayFolder: Productividad 2.0
		lineageTag: 114b0ffd-d496-43fd-8885-a254dd2a47fa

	measure Paquetes = ```
			
