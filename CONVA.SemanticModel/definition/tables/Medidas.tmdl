table Medidas
	lineageTag: eebd7fe0-ce77-4ba6-b7d2-44675b70c90a

	measure Ticket =
			
			CALCULATE (
			    COUNTROWS ( BBDD ),
			    REMOVEFILTERS ( BBDD[Estado] ),
			    KEEPFILTERS ( BBDD[Estado] = "Ticket" )
			)
		formatString: 0
		lineageTag: c241992c-438f-4f4c-847e-7e10e9ca23a2

	measure Paquete =
			
			CALCULATE (
			    COUNTROWS ( BBDD ),
			    REMOVEFILTERS ( BBDD[Estado] ),
			    KEEPFILTERS ( BBDD[Estado] = "Paquete" )
			)
		formatString: 0
		lineageTag: d7a72f1a-46bd-43a8-9cd6-c794a795f1f1

	measure 'Total Registros' =
			
			CALCULATE (
			    COUNTROWS ( BBDD ),
			    REMOVEFILTERS ( BBDD[Estado] )
			)
		formatString: 0
		lineageTag: 68d4fd23-11da-4c89-88ba-f60b49ed58b8

	measure Cerrado =
			
			CALCULATE (
			    COUNTROWS ( BBDD ),
			    REMOVEFILTERS ( BBDD[Estado] ),
			    KEEPFILTERS ( BBDD[Estado] = "Cerrado" )
			)
		formatString: 0
